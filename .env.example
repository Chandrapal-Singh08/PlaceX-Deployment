# PostgreSQL / Supabase PostgreSQL connection string for the FastAPI server.
PLACEX_DSN=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Groq LLM integration (optional; keep the API key server-side).
PLACEX_LLM_PROVIDER=groq
GROQ_API_KEY=replace-with-your-groq-api-key
GROQ_MODEL=openai/gpt-oss-20b

# Provider request limits.
PLACEX_LLM_TIMEOUT_S=20
PLACEX_LLM_MAX_RETRIES=1
PLACEX_LLM_MAX_OUTPUT_TOKENS=1200
PLACEX_JOURNEY_MAX_OUTPUT_TOKENS=4096
PLACEX_LLM_MAX_INPUT_CHARS=20000

# Optional ATS weight overrides (JSON object; unspecified dimensions use defaults).
PLACEX_MATCH_WEIGHTS={"exact_skill_match":0.5,"semantic_skill_match":0.15,"experience_match":0.1,"project_relevance":0.1,"responsibility_match":0.1,"eligibility_match":0.05}

# Optional lazy-loaded semantic matching. Install requirements-ml.txt and cache
# the selected model locally before enabling with local-files-only=true.
PLACEX_EMBEDDINGS_ENABLED=false
PLACEX_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
PLACEX_EMBEDDING_DEVICE=
PLACEX_EMBEDDING_LOCAL_FILES_ONLY=true
PLACEX_EMBEDDING_SIMILARITY_THRESHOLD=0.72

# Optional permitted JSON job API/feed. No listings are fabricated when unset.
PLACEX_JOB_PROVIDER_URL=
PLACEX_JOB_PROVIDER_NAME=configured-json-api
PLACEX_JOB_PROVIDER_API_KEY=
PLACEX_JOB_PROVIDER_TIMEOUT_S=10

# Optional live web research (Brave Search API; Groq is not a search provider).
# When unset/none, PlaceX clearly reports that live web research is unavailable.
PLACEX_RESEARCH_PROVIDER=none
BRAVE_SEARCH_API_KEY=
PLACEX_RESEARCH_TIMEOUT_S=10
PLACEX_RESEARCH_CACHE_TTL_SECONDS=86400
PLACEX_RESEARCH_RESULT_LIMIT=8

# Comma-separated browser origins allowed by the API.
PLACEX_ALLOWED_ORIGINS=https://your-frontend.example
